+namespace {
+// A normal 100 kHz byte transaction completes in well under a millisecond. Allow substantial
+// clock-stretching margin, but never let a wedged I2C bus halt the SAMD21 forever.
+constexpr uint32_t WIRE_OPERATION_TIMEOUT_MS = 100;
+}
 
