      "issues": [
        {
          "requirement": "Write an example",
          "reason": "Host GNSS checks and ARM compile/link checks pass. Live upload verification, modem initialization, SIM readiness, Hologram registration on Verizon LTE-M, application IP, real HTTP traffic with GNSS off, RTC sync and Loom packaging pass. GNSS control/raw queries respond, but no valid satellite fix has been observed by the window. Concurrent GNSS/socket traffic, heap/stack margins and transmit power stability remain unverified.",
          "sourceLinks": [
            "0",
            "1",
            "5"
          ]
        }
      ]
    },
